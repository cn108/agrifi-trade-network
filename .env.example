# Copy this file to .env for local Docker Compose use. Replace both passwords.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200
JWT_REFRESH_COOKIE_SECURE=false
JWT_REFRESH_COOKIE_SAMESITE=Lax

POSTGRES_DB=agrifi
POSTGRES_USER=agrifi
POSTGRES_PASSWORD=replace-with-a-local-database-password

DB_NAME=agrifi
DB_USER=agrifi
DB_PASSWORD=replace-with-a-local-database-password
DB_HOST=postgres
DB_PORT=5432
